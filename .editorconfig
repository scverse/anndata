root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 88

# TOML is formatted by taplo, which is configured for 4 spaces in .taplo.toml
[{*.{yml,yaml},.cruft.json}]
indent_size = 2

[Makefile]
indent_style = tab
