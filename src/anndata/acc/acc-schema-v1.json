{
    "$id": "https://anndata.scverse.org/en/stable/acc-schema-v1.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "ref": {
            "title": "Reference to a vector or matrix (AdRef)",
            "type": "array",
            "oneOf": [
                {
                    "title": "Layer vector (layers)",
                    "minItems": 4,
                    "maxItems": 4,
                    "anyOf": [
                        {
                            "prefixItems": [
                                { "const": "layers" },
                                { "type": ["string", "null"] },
                                { "type": ["string", "null"] },
                                { "const": null }
                            ]
                        },
                        {
                            "prefixItems": [
                                { "const": "layers" },
                                { "type": ["string", "null"] },
                                { "const": null },
                                { "type": ["string", "null"] }
                            ]
                        }
                    ]
                },
                {
                    "title": "Annotation vector (obs/var)",
                    "minItems": 2,
                    "maxItems": 2,
                    "prefixItems": [
                        { "enum": ["obs", "var"] },
                        { "type": ["string", "null"] }
                    ]
                },
                {
                    "title": "Vector from a multi-dimensional annotation (obsm/varm)",
                    "minItems": 3,
                    "maxItems": 3,
                    "prefixItems": [
                        { "enum": ["obsm", "varm"] },
                        { "type": "string" },
                        { "type": "integer" }
                    ]
                },
                {
                    "title": "Column of a data frame in a multi-dimensional annotation (obsm/varm …DF)",
                    "minItems": 3,
                    "maxItems": 3,
                    "prefixItems": [
                        { "enum": ["obsm", "varm"] },
                        { "type": "string" },
                        { "$ref": "#/$defs/df-cast" }
                    ]
                },
                {
                    "title": "Graph vector (obsp/varp)",
                    "minItems": 4,
                    "maxItems": 4,
                    "anyOf": [
                        {
                            "prefixItems": [
                                { "enum": ["obsp", "varp"] },
                                { "type": "string" },
                                { "type": ["string", "null"] },
                                { "const": null }
                            ]
                        },
                        {
                            "prefixItems": [
                                { "enum": ["obsp", "varp"] },
                                { "type": "string" },
                                { "const": null },
                                { "type": ["string", "null"] }
                            ]
                        }
                    ]
                },
                {
                    "title": "Column of a data frame in unstructured annotation (uns …DF)",
                    "minItems": 3,
                    "maxItems": 3,
                    "prefixItems": [
                        { "const": "uns" },
                        { "$ref": "#/$defs/uns-path" },
                        { "$ref": "#/$defs/df-cast" }
                    ]
                },
                {
                    "title": "Reference into an AnnData object in unstructured annotation (uns …AD)",
                    "minItems": 3,
                    "maxItems": 3,
                    "prefixItems": [
                        { "const": "uns" },
                        { "$ref": "#/$defs/uns-path" },
                        {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "prefixItems": [
                                { "const": "AD" },
                                { "$ref": "#/$defs/ref" }
                            ]
                        }
                    ]
                }
            ]
        },
        "acc": {
            "title": "Reference accessor for a whole container (LayerAcc/MultiAcc/GraphAcc/ItemAcc/DFAcc)",
            "type": "array",
            "oneOf": [
                {
                    "title": "Whole layer or X (layers)",
                    "minItems": 2,
                    "maxItems": 2,
                    "prefixItems": [
                        { "const": "layers" },
                        { "type": ["string", "null"] }
                    ]
                },
                {
                    "title": "Whole multi-dimensional annotation (obsm/varm)",
                    "minItems": 2,
                    "maxItems": 2,
                    "prefixItems": [
                        { "enum": ["obsm", "varm"] },
                        { "type": "string" }
                    ]
                },
                {
                    "title": "Whole graph (obsp/varp)",
                    "minItems": 2,
                    "maxItems": 2,
                    "prefixItems": [
                        { "enum": ["obsp", "varp"] },
                        { "type": "string" }
                    ]
                },
                {
                    "title": "Whole data frame in a multi-dimensional annotation (obsm/varm …DF)",
                    "minItems": 3,
                    "maxItems": 3,
                    "prefixItems": [
                        { "enum": ["obsm", "varm"] },
                        { "type": "string" },
                        { "const": ["DF"] }
                    ]
                },
                {
                    "title": "Whole data frame in unstructured annotation (uns …DF)",
                    "minItems": 3,
                    "maxItems": 3,
                    "prefixItems": [
                        { "const": "uns" },
                        { "$ref": "#/$defs/uns-path" },
                        { "const": ["DF"] }
                    ]
                },
                {
                    "title": "Item in unstructured annotation (uns)",
                    "minItems": 2,
                    "maxItems": 2,
                    "prefixItems": [
                        { "const": "uns" },
                        { "$ref": "#/$defs/uns-path" }
                    ]
                },
                {
                    "title": "Container in an AnnData object in unstructured annotation (uns …AD)",
                    "minItems": 3,
                    "maxItems": 3,
                    "prefixItems": [
                        { "const": "uns" },
                        { "$ref": "#/$defs/uns-path" },
                        {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "prefixItems": [
                                { "const": "AD" },
                                { "$ref": "#/$defs/acc" }
                            ]
                        }
                    ]
                }
            ]
        },
        "uns-path": {
            "title": "Path to an item in uns: one or more keys",
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
        },
        "df-cast": {
            "title": "Column (or index if null) of the data frame cast from the preceding item",
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [{ "const": "DF" }, { "type": ["string", "null"] }]
        }
    },
    "oneOf": [{ "$ref": "#/$defs/ref" }, { "$ref": "#/$defs/acc" }]
}
